{
  "name": "prd-agent",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint --fix 'src/**/*.ts' 'src/**/*.tsx'",
    "lint:css": "stylelint --fix src/**/*.css",
    "preview": "vite preview",
    "lint:eslint": "eslint 'src/**/*.ts' 'src/**/*.tsx'",
    "format": "prettier --write . --ignore-path .gitignore",
    "format:check": "prettier --check ./src",
    "test": "jest --silent --verbose",
    "test:watch": "jest --silent --watch --verbose",
    "test:silent": "jest --silent --no-coverage",
    "test:nocoverage": "jest --verbose --no-coverage",
    "ci": "yarn check-circular && yarn check-types  && yarn lint:eslint && yarn lint:css && yarn cover --coverageReporters=cobertura --maxWorkers=2 --silent",
    "check-circular": "madge --circular src --extensions ts,tsx",
    "check-types": "tsc --noEmit --skipLibCheck --incremental false",
    "check-structure": "yarn steiger ./src",
    "cover": "yarn test --coverage",
    "tsc:check": "tsc",
    "start": "vite preview"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.1",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-scroll-area": "^1.2.8",
    "@radix-ui/react-toast": "^1.2.13",
    "@sentry/react": "^8.51.0",
    "@sentry/vite-plugin": "^3.1.0",
    "@types/is-base64": "^1.1.3",
    "@types/three": "^0.176.0",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "firebase": "^11.2.0",
    "is-base64": "^1.1.0",
    "lucide-react": "^0.510.0",
    "mime-types": "^2.1.35",
    "moment": "^2.30.1",
    "react": "^18.3.1",
    "react-audio-visualize": "^1.2.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-markdown": "^9.0.3",
    "react-modal": "^3.16.3",
    "react-resizable-panels": "^3.0.2",
    "react-router": "^7.1.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.176.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jest": "^29.5.14",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^18.3.5",
    "@types/react-modal": "^3.16.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "babel-jest": "^29.7.0",
    "eslint": "8.43.0",
    "eslint-plugin-jest": "^27.2.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-sort-imports-es6-autofix": "^0.6.0",
    "eslint-plugin-typescript-sort-keys": "^2.3.0",
    "globals": "^15.14.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.8",
    "jest-environment-jsdom": "^29.7.0",
    "madge": "^6.1.0",
    "postcss": "^8.5.25",
    "postcss-styled-syntax": "^0.7.2",
    "prettier": "^3.9.6",
    "steiger": "^0.6.0",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-tailwindcss": "^0.0.7",
    "stylelint-order": "^6.0.4",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.5",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "madge": {
    "fileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx"
    ],
    "circular": true,
    "warning": true
  },
  "prettier": {
    "trailingComma": "all"
  }
}
