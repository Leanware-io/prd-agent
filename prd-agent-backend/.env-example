# Copy this file to .env and fill in the values. Never commit .env.
# This list mirrors the variables actually read by prd_agent/settings.py and the
# agent package — keep it in sync when you add a new one.

# --- Django core -------------------------------------------------------------
SECRET_KEY=""
# "True" enables Django debug mode. Never enable in a deployed environment.
APP_DEBUG="False"
# One of: local | test | staging | production
ENVIRONMENT="local"

# --- Database ----------------------------------------------------------------
# Full Postgres connection URL. Historical name, kept for compatibility:
# this configures Django's DATABASES, not SQLAlchemy.
SQLALCHEMY_DATABASE_URI=""

# --- Google Cloud ------------------------------------------------------------
# Path to a service account JSON file. Keep the file itself out of the repo.
GOOGLE_APPLICATION_CREDENTIALS=""
# Cloud Storage bucket for generated PRD and quote PDFs.
PRD_BUCKET=""

# --- Agent service -----------------------------------------------------------
# Base URL of the ADK agent service (see agents/).
AI_SERVICE_URL="http://localhost:8000"
AI_APP_NAME="agents"
# Gemini model ID. Defaults to gemini-2.5-pro when unset.
MODEL=""
# Optional. Path to a JSON rate card for the quoting agent. When unset, the
# placeholder figures in agents/sub_agents/quote/rate_card.example.json are used
# and generated quotes are NOT based on real commercial rates.
QUOTE_RATE_CARD_PATH=""

# --- Model providers (optional, for alternative backends) --------------------
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Sessions ----------------------------------------------------------------
# Signs chat session keys.
SESSIONS_SECRET_KEY=""

# --- Notifications -----------------------------------------------------------
SENDGRID_API_KEY=""
EMAIL_SENDER="no-reply@example.com"
# Internal address that receives new-lead notifications.
TEAM_EMAIL=""
SLACK_BOT_TOKEN=""
SLACK_CHANNEL_ID=""

# --- Observability -----------------------------------------------------------
SENTRY_DSN=""
